# WooCommerce store the API talks to.
BASE_URL=https://your-woocommerce-store.com

# WooCommerce REST API keys (Settings -> Advanced -> REST API),
# with Read/Write permission. Prefer a staging store.
CONSUMER_KEY=ck_your_consumer_key
CONSUMER_SECRET=cs_your_consumer_secret

# Shown in the UI footer.
version=1.0.0

# Port for the Express API. Render injects its own PORT; leave unset there.
PORT=5000

# Comma-separated list of allowed frontend origins.
# Leave unset locally to allow any origin.
# On Render, set to your Vercel URL, e.g. https://woo-helper.vercel.app
FRONTEND_ORIGIN=

# Set to "true" on a public deploy so every request must carry store
# credentials from the dashboard, instead of falling back to the keys above.
REQUIRE_STORE_CREDENTIALS=

# Per-request timeout when calling WooCommerce (default 60000).
WOO_TIMEOUT_MS=
